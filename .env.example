# Firma de cookies de sesión y del permiso temporal para agendar.
# Obligatorio en producción: el portal no arranca sin él.
SESSION_SECRET=

# Postgres. El puerto 6543 es el pooler en modo transacción (la aplicación);
# el 5432 es sesión completa y solo lo usan las migraciones y los scripts.
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=

# Esquema de trabajo. EN LOCAL PONLO EN `dev`: es una réplica completa del
# esquema —mismas tablas, mismos triggers, mismas restricciones— dentro de la
# misma base, y es lo único que impide que tu servidor de desarrollo escriba
# sobre los datos reales del despacho. `db:migrate` y `db:seed` siguen esta
# misma variable, así que migrar, sembrar y leer no pueden desacoplarse.
# En Vercel NO se define: producción es `public`.
POSTGRES_SCHEMA=dev

# WhatsApp del despacho, en formato internacional y solo dígitos (52 + 10).
# SIN ESTO la opción de WhatsApp no se ofrece: más vale una pantalla con dos
# caminos que un botón que abre una conversación con el número equivocado.
SOLO_LABORAL_WHATSAPP_NUMBER=

# Opcional. Marcadores: {full_name} {state_label} {dismissal_days} {folio}
WHATSAPP_MESSAGE_TEMPLATE=

# Ventana de la llamada próxima, en minutos. El evento se agenda en el mínimo.
QUICK_CALL_MIN_DELAY=10
QUICK_CALL_MAX_DELAY=15

# Contraseña de las dos cuentas de demostración que crea `npm run db:seed`.
# No se escribe en el código: el repositorio es público y esas cuentas entran
# al portal real. Mínimo diez caracteres, con minúscula, mayúscula y número.
SEED_DEMO_PASSWORD=

# AVISOS AL DESPACHO cuando entra un caso calificado o alguien pide que le
# llamen enseguida. Sin las TRES no se avisa y no pasa nada más: un aviso que
# no sale nunca impide que se guarde una solicitud.
RESEND_API_KEY=                 # resend.com. Sin ella no se envía nada
MAIL_FROM=                      # "Avisos <avisos@dominio-verificado.mx>"
                                # el dominio debe estar verificado en Resend
ALERTA_DESTINOS=                # a quién se avisa, separados por coma.
                                # Varias direcciones a propósito: el aviso vale
                                # si alguien lo lee en minutos, y una sola
                                # dirección depende de que esa persona no esté
                                # en una audiencia
SITE_URL=                       # https://portal-solo-laboral.vercel.app
                                # de dónde cuelgan los enlaces del correo

# Días sin novedad tras los que un lead pasa a "Sin respuesta". Los cuenta el
# cron diario desde la llamada que pidió, o desde su registro si no pidió
# ninguna. Por omisión, 5.
LEAD_NO_RESPONSE_DAYS=

# Secreto del cron de mantenimiento. Sin él, /api/cron/mantenimiento responde
# 404: el repositorio es público y el dominio es adivinable.
CRON_SECRET=
