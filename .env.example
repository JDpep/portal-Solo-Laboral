# Firma de cookies de sesión y del permiso temporal para agendar.
# Obligatorio en producción: el portal no arranca sin él.
SESSION_SECRET=

# Postgres. El puerto 6543 es el pooler en modo transacción (la aplicación);
# el 5432 es sesión completa y solo lo usan las migraciones y los scripts.
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=

# WhatsApp del despacho, en formato internacional y solo dígitos (52 + 10).
# SIN ESTO la opción de WhatsApp no se ofrece: más vale una pantalla con dos
# caminos que un botón que abre una conversación con el número equivocado.
SOLO_LABORAL_WHATSAPP_NUMBER=

# Opcional. Marcadores: {full_name} {state_label} {dismissal_days} {folio}
WHATSAPP_MESSAGE_TEMPLATE=

# Ventana de la llamada próxima, en minutos. El evento se agenda en el mínimo.
QUICK_CALL_MIN_DELAY=10
QUICK_CALL_MAX_DELAY=15

# Contraseña de las dos cuentas de demostración que crea `npm run db:seed`.
# No se escribe en el código: el repositorio es público y esas cuentas entran
# al portal real. Mínimo diez caracteres, con minúscula, mayúscula y número.
SEED_DEMO_PASSWORD=
